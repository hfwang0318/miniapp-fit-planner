.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  background-color: #FFFFFF;
}

.status-bar-spacer {
  padding-top: calc(88rpx + constant(safe-area-inset-top));
  padding-top: calc(88rpx + env(safe-area-inset-top));
}

.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  justify-content: center;
  padding-bottom: 120rpx;
}

.brand-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #07C160;
  margin-bottom: 16rpx;
}

.brand-desc {
  font-size: 28rpx;
  color: #999999;
}

.login-btn-area {
  padding-bottom: 48rpx;
}

/* Nickname modal styles */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 48rpx;
}

.btn-wechat-profile {
  width: 100%;
  height: 96rpx;
  background-color: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0;
}

.btn-wechat-profile::after {
  border: none;
}

.modal-divider {
  width: 100%;
  display: flex;
  align-items: center;
  margin: 32rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #E5E5E5;
}

.divider-text {
  font-size: 24rpx;
  color: #999999;
  padding: 0 24rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.nickname-input:focus {
  border-color: #07C160;
}

.avatar-checkbox-group {
  width: 100%;
  margin-bottom: 32rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
}

.checkbox-text {
  font-size: 28rpx;
  color: #666666;
  margin-left: 8rpx;
}

.btn-confirm {
  width: 100%;
  height: 88rpx;
  background-color: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-confirm::after {
  border: none;
}