/* Fit Planner — Global Styles */

page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

/* ===== Brand Colors ===== */
/* Primary: #07C160 (WeChat green) */
/* Secondary: #1989FA (blue accent) */

/* ===== Layout ===== */
.page-container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

/* ===== Card ===== */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ===== Buttons ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background-color: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  background-color: #92DEB0;
  color: rgba(255, 255, 255, 0.6);
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background-color: #F5F5F5;
  color: #333333;
  font-size: 32rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E5E5E5;
}

.btn-small {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.btn-danger {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #EE0A24;
  border: 2rpx solid #EE0A24;
  border-radius: 8rpx;
  background-color: transparent;
}

/* ===== Typography ===== */
.text-muted {
  color: #999999;
  font-size: 24rpx;
}

.text-center {
  text-align: center;
}

/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-state text {
  color: #999999;
  font-size: 28rpx;
}

/* ===== Loading ===== */
.loading-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

/* ===== Safe Area ===== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== Divider ===== */
.divider {
  height: 1rpx;
  background-color: #F0F0F0;
  margin: 16rpx 0;
}
